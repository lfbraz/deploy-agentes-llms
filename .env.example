# Copie este arquivo para .env e preencha com suas chaves.
# Todos os exemplos funcionam SEM chave (modo mock), mas com a chave você
# verá o agente raciocinando de verdade com um LLM.

# Anthropic Claude (provedor padrão dos exemplos)
ANTHROPIC_API_KEY=<sua chave de API>

# Modelo a ser usado (opcional). Padrão: claude-sonnet-4-6
LLM_MODEL=claude-sonnet-4-6
