# Copie para .env e preencha. Todos os exemplos funcionam SEM chave (modo mock).

# Provedor padrão: anthropic (Claude). Use "openai" para a OpenAI API.
LLM_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI (usado quando LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Modelo (opcional). Padrão: claude-sonnet-4-6 (anthropic) ou gpt-4o-mini (openai)
LLM_MODEL=
