# Copie para .env. O notebook desta aula usa LLM REAL (Claude) e faz chamada HTTP real.

# Provedor do LLM (passo de geração do RAG e tool use). Padrão: anthropic (Claude).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# API Key da Awesome API (https://awesomeapi.com.br/)
AWESOME_API_KEY=<sua-api-key-aqui>