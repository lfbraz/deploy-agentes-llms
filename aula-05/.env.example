# ── Aula 05 — Guardrails com Databricks Free Edition ────────────────────────
# Copie este arquivo para .env (mesma pasta) e preencha com os seus dados.
# O .env está no .gitignore — suas credenciais NÃO vão para o GitHub.

# URL do workspace Databricks Free Edition
# Ex.: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com  (sem barra no final)
DATABRICKS_HOST=

# Personal Access Token (PAT)
# Gere em:  Configurações do usuário > Desenvolvedor > Tokens de acesso > Gerar token
DATABRICKS_TOKEN=

# Nomes dos endpoints de Model Serving (gpt-oss-20b) criados no seu workspace.
# Um SEM nenhum guardrail e outro COM os guardrails do AI Gateway ativados
# (PII redaction, PII detection, unsafe content, jailbreak e hallucination).
ENDPOINT_SEM_GUARDRAILS=gpt-oss-20b-no-guardrails
ENDPOINT_COM_GUARDRAILS=gpt-oss-20b-with-guardrails
