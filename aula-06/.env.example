# Copie para .env e preencha.
#
# Notebook `exercicio_eval_observabilidade.ipynb` (scorers do MLflow): usa a API REAL do
# MLflow GenAI (`mlflow.genai.evaluate`) com um endpoint da Databricks como MODELO JUIZ, pela
# via NATIVA do AI Gateway — preencha DATABRICKS_* abaixo. Requer `pip install "mlflow>=3.6"`.
# Notebook `tracing_mlflow.ipynb` (observabilidade por tracing): roda offline, sem chaves.

# ── Databricks (modelo juiz dos scorers do MLflow) ──────────────────────────
# URL do workspace (sem barra no final) e Personal Access Token.
DATABRICKS_HOST=https://dbc-xxxx-yyyy.cloud.databricks.com
DATABRICKS_TOKEN=

# Endpoint de chat usado como juiz (Foundation Model API ou qualquer serving endpoint).
ENDPOINT_GPT_OSS_20B=databricks-gpt-oss-20b

# ── Opcional — observabilidade/telemetria gerenciada (tracing automático) ────
# LangSmith (tracing nativo do LangChain):
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=deploy-agentes-aula-06
# AgentOps (telemetria de agentes):
# AGENTOPS_API_KEY=
