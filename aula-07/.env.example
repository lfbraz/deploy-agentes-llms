# ── Aula 07 — LLMOps: agente Databricks (sem modo offline) ──────────────────
# Copie este arquivo para .env (mesma pasta) e preencha. O .env está no .gitignore.
#
# A Aula 07 roda SEMPRE contra o Databricks: o agente, o registry, o serving e o
# monitoramento usam serviços reais do workspace. Sem estas credenciais, os exemplos
# exibem uma mensagem de pré-requisito e encerram.

# URL do workspace Databricks (Free Edition serve), sem barra no final.
# Ex.: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# Personal Access Token (PAT).
# Gere em: Configurações do usuário > Desenvolvedor > Tokens de acesso > Gerar token.
DATABRICKS_TOKEN=

# Endpoint de Model Serving usado como "cérebro" do agente (exemplos 01, 03, 05, 06).
# IMPORTANTE: precisa suportar TOOL CALLING (function calling). Use um Claude servido pelo
# Databricks. NÃO use o databricks-gpt-oss-20b aqui (não faz tool calling — vide Aula 6).
ENDPOINT_LLM_AGENTE=databricks-claude-sonnet-4-5

# Endpoint de embeddings para a base vetorial / RAG (DatabricksEmbeddings).
ENDPOINT_EMBEDDINGS=databricks-gte-large-en

# Exemplo 04 (serving com cascata): um endpoint PEQUENO/barato e um GRANDE/capaz.
ENDPOINT_LLM_PEQUENO=databricks-llama-4-maverick
ENDPOINT_LLM_GRANDE=databricks-claude-sonnet-4-5

# Nome de três níveis do Unity Catalog para o registry (exemplo 02) e o deploy.
# Define o catálogo.schema usados (ex.: catalogo.schema.agente_suporte).
MODELO_UC=main.default.agente_suporte
