# ── Aula 07 — LLMOps: configuração do agente no Databricks ──────────────────
# Copie este arquivo para .env (mesma pasta) e preencha. O .env está no .gitignore.
#
# Necessário apenas ao rodar FORA do Databricks (localmente). Dentro de um notebook do
# workspace, a autenticação vem do próprio runtime e estas variáveis são dispensáveis.

# URL do workspace Databricks, sem barra no final.
# Ex.: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# Personal Access Token (PAT).
# Gere em: Configurações do usuário > Desenvolvedor > Tokens de acesso > Gerar token.
DATABRICKS_TOKEN=

# Catálogo e schema do Unity Catalog onde criamos as UC Functions, a tabela de políticas,
# o índice de Vector Search, o modelo registrado e o prompt. Precisa de permissão de escrita.
# O 00_setup cria o catálogo/schema se não existirem (CREATE CATALOG IF NOT EXISTS).
UC_CATALOG=aula_07
UC_SCHEMA=default

# Endpoint de Model Serving usado como "cérebro" do agente.
# IMPORTANTE: precisa suportar TOOL CALLING (function calling). Use um Claude servido pelo
# Databricks. NÃO use o databricks-gpt-oss-20b aqui (não faz tool calling — vide Aula 6).
ENDPOINT_LLM_AGENTE=databricks-meta-llama-3-3-70b-instruct

# Endpoint de embeddings usado pelo índice de Vector Search (embeddings gerenciados).
ENDPOINT_EMBEDDINGS=databricks-qwen3-embedding-0-6b

# Endpoint (compute) de Vector Search que serve o índice das políticas (RAG).
ENDPOINT_VECTOR_SEARCH=agente_suporte_vs

# Experimento do MLflow (traces/feedback dos exemplos 01/03).
# Por padrão, os traces são gravados como tabelas no Unity Catalog em
# aula_07.default (prefixo experimento_aula_07). Para isso é preciso:
#   1) ligar o preview "OpenTelemetry on Databricks" no workspace; e
#   2) informar o ID de um SQL warehouse abaixo (SQL Warehouses > seu warehouse > ID).
# Sem o warehouse, cai-se num experimento comum de workspace (sem tabelas no UC).
MLFLOW_TRACING_SQL_WAREHOUSE_ID=
# (Opcional) caminho de workspace do experimento. Padrão: /Users/<seu-usuário>/experimento_aula_07.
# MLFLOW_EXPERIMENT=/Users/voce@exemplo.com/experimento_aula_07
# (Opcional) prefixo das tabelas de trace no UC. Padrão: experimento_aula_07.
# MLFLOW_TRACE_PREFIX=experimento_aula_07
# (Opcional) experimento de PRODUÇÃO: onde o exemplo 05 registra o modelo e onde o endpoint
# grava as traces/feedback. Padrão: /Users/<seu-usuário>/agente_suporte_producao.
# MLFLOW_EXPERIMENT_PROD=/Users/voce@exemplo.com/agente_suporte_producao

# (Opcional) Nome de três níveis do modelo registrado p/ deploy e do prompt no registry.
# Por padrão derivam de UC_CATALOG/UC_SCHEMA (ex.: main.default.agente_suporte).
# MODELO_UC=main.default.agente_suporte
# PROMPT_UC=main.default.agente_suporte_prompt
# (Opcional) modelo juiz do LLM-as-a-judge no gate (exemplo 04). Padrão: databricks-gpt-oss-120b.
# ENDPOINT_JUIZ=databricks-gpt-oss-120b
# (Opcional) alias do prompt que o agente carrega. Padrão: champion (o pipeline usa challenger).
# PROMPT_ALIAS=champion
# (Opcional) Service Principal do endpoint e secret scope das credenciais dele (exemplo 00b).
# SP_NOME=aula-07-agente-suporte
# SECRET_SCOPE=aula_07

# (Opcional) Nome da loja usado no system prompt ({{loja}}).
# NOME_LOJA=Acme
