# ── Aula 07 — LLMOps: configuração do agente no Databricks ──────────────────
# Copie este arquivo para .env (mesma pasta) e preencha. O .env está no .gitignore.
#
# Necessário apenas ao rodar FORA do Databricks (localmente). Dentro de um notebook do
# workspace, a autenticação vem do próprio runtime e estas variáveis são dispensáveis.

# URL do workspace Databricks, sem barra no final.
# Ex.: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# Personal Access Token (PAT).
# Gere em: Configurações do usuário > Desenvolvedor > Tokens de acesso > Gerar token.
DATABRICKS_TOKEN=

# Catálogo e schema do Unity Catalog onde criamos as UC Functions, a tabela de políticas,
# o índice de Vector Search, o modelo registrado e o prompt. Precisa de permissão de escrita.
UC_CATALOG=main
UC_SCHEMA=default

# Endpoint de Model Serving usado como "cérebro" do agente.
# IMPORTANTE: precisa suportar TOOL CALLING (function calling). Use um Claude servido pelo
# Databricks. NÃO use o databricks-gpt-oss-20b aqui (não faz tool calling — vide Aula 6).
ENDPOINT_LLM_AGENTE=databricks-claude-sonnet-4-5

# Endpoint de embeddings usado pelo índice de Vector Search (embeddings gerenciados).
ENDPOINT_EMBEDDINGS=databricks-gte-large-en

# Endpoint (compute) de Vector Search que serve o índice das políticas (RAG).
ENDPOINT_VECTOR_SEARCH=agente_suporte_vs

# (Opcional) Nome de três níveis do modelo registrado p/ deploy e do prompt no registry.
# Por padrão derivam de UC_CATALOG/UC_SCHEMA (ex.: main.default.agente_suporte).
# MODELO_UC=main.default.agente_suporte
# PROMPT_UC=main.default.agente_suporte_prompt

# (Opcional) Nome da loja usado no system prompt ({{loja}}).
# NOME_LOJA=Acme
